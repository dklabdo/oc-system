{
  "identifier": "main-capability",
  "windows": ["main", "ERP"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "shell:default",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-set-webview-focus",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" },
        { "url": "mailto:*" },
        { "url": "tel:*" }
      ]
    }
  ]
}